# ==========================================
# API KEYS CONFIGURATION
# ==========================================

# Gemini API (Google) - Required for Chat/Agent
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Claude API (Anthropic) - Alternative to Gemini
# Get from: https://console.anthropic.com
CLAUDE_API_KEY=your_claude_api_key_here

# OpenAI API - Alternative to Gemini
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# National Vulnerability Database (NVD) API - Required for CVE Search
# Get from: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=9be67211-6db1-456c-ba55-2f1376ad0453

# VirusTotal API - Optional, for malware scanning
# Get from: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
